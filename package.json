{
  "name": "harnessbox",
  "version": "0.5.0",
  "description": "Per-user bubblewrap boxes for agent CLIs (Claude Code, Codex, Grok): each user's own login, an egress allowlist, no credential in the host app",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.mjs"
    }
  },
  "files": [
    "src",
    "deploy",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.2"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thsvkd/harnessbox.git"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "probe": "node deploy/probe.mjs",
    "sign-client": "node scripts/sign-client.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
